# Trading Engine — Mac / Linux / VPS (real APIs)
APP_NAME=trading-engine
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local dashboard + Vercel previews (regex in engine)
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=1h
LOOKBACK_PERIOD=730d
DATA_SOURCE=yahoo
FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURGBP,EURJPY,GBPJPY,AUDJPY,EURAUD,EURCHF,GBPCHF,XAUUSD

# Optional second real provider (https://twelvedata.com — free API key)
TWELVE_DATA_API_KEY=

SWING_LOOKBACK=5
FVG_MIN_GAP_PCT=0.0002
LIQUIDITY_EQUAL_TOLERANCE=0.0005
PREMIUM_DISCOUNT_LEVEL=0.5
RISK_REWARD_RATIO=2.0
SL_BUFFER_PCT=0.0005
INITIAL_BALANCE=10000
RISK_PER_TRADE_PCT=0.01

DATABASE_URL=postgresql://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# Dashboard (local)
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
