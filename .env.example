# Trading Engine
APP_NAME=trading-engine
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=1h
LOOKBACK_PERIOD=60d
SWING_LOOKBACK=5
FVG_MIN_GAP_PCT=0.0002
LIQUIDITY_EQUAL_TOLERANCE=0.0005
PREMIUM_DISCOUNT_LEVEL=0.5
RISK_REWARD_RATIO=2.0
SL_BUFFER_PCT=0.0005
INITIAL_BALANCE=10000
RISK_PER_TRADE_PCT=0.01

DATABASE_URL=postgresql://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# MT5 — fill on Windows/VPS only (not used in Mac V1)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Dashboard
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
